<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 白い熊 画 カメラ: OCR through the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- 保存復元 automation (sister-app contract v2): the job service, and the CPU kept awake under
         a long export (EMUI otherwise dozes it with the screen off). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Without these the automation replies' setPackage() fails silently on Android 11+ — BOTH
         callers (応用管理 restores, 自由作業盤 runs the 保存復元 batch). -->
    <queries>
        <package android:name="shiroikuma.oyokanri" />
        <package android:name="shiroikuma.jiyusagyoban" />
    </queries>

    <!-- 白い熊 画 never touches the network: keep any library from merging these back in. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name="shiroikuma.kaku.KakuApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <receiver android:name=".MainService$CloseMainService" android:exported="false" />
        <receiver android:name=".MainService$TogglePageModeMainService" android:exported="false" />
        <receiver android:name=".MainService$ToggleInstantModeMainService" android:exported="false" />
        <receiver android:name=".MainService$ToggleImagePreviewMainService" android:exported="false" />
        <receiver android:name=".MainService$ToggleShowHideMainService" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:noHistory="false"
            android:launchMode="standard"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: 「カメラ」, pinnable to the home screen as its own one-tap shortcut. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- 白い熊 画 カメラ — OCR through the camera. Its own task, so it opens straight into the camera
             from the home screen; exported for 自由作業盤 / Tasker (shiroikuma.kaku.action.CAMERA). -->
        <activity
            android:name="shiroikuma.kaku.camera.CameraActivity"
            android:label="@string/camera_label"
            android:icon="@mipmap/ic_launcher_camera"
            android:roundIcon="@mipmap/ic_launcher_camera"
            android:taskAffinity="shiroikuma.kaku.camera"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="shiroikuma.kaku.action.CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Its launcher icon — a second icon in the app drawer, switched on the UI page (on by default). -->
        <activity-alias
            android:name="shiroikuma.kaku.camera.CameraLauncherAlias"
            android:targetActivity="shiroikuma.kaku.camera.CameraActivity"
            android:label="@string/camera_label"
            android:icon="@mipmap/ic_launcher_camera"
            android:roundIcon="@mipmap/ic_launcher_camera"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".TutorialActivity"
            android:label="@string/tutorial_label"
            android:noHistory="false"
            android:launchMode="standard"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
        </activity>

        <activity
            android:name=".PassthroughActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name="shiroikuma.kaku.KakuUiActivity"
            android:label="@string/kaku_ui_open"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <activity
            android:name="shiroikuma.kaku.ProjectionConsentActivity"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <!-- §1: the unauthenticated half of the surface — writes where it is told to, reports what
             it did. No android:permission by design (the caller cannot hold one). -->
        <receiver
            android:name="shiroikuma.kaku.automation.StateExportReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.action.EXPORT_STATE" />
                <action android:name="${applicationId}.action.LIST_CATEGORIES" />
                <action android:name="${applicationId}.action.CANCEL_EXPORT" />
            </intent-filter>
        </receiver>

        <!-- §2a: the data door — describe / export / import / cancel for a verified caller. -->
        <provider
            android:name="shiroikuma.kaku.automation.AutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Yomitan dictionary import (minutes of work: a dataSync foreground service). -->
        <service
            android:name="shiroikuma.kaku.dict.DictImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Where every automation job runs (§1 state exports and §2a data-door jobs). -->
        <service
            android:name="shiroikuma.kaku.automation.AutomationDataService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Capability discovery, readable without waking the app (integers — read with getInt). -->
        <meta-data android:name="shiroikuma.automation.contract" android:value="2" />
        <meta-data android:name="shiroikuma.automation.format" android:value="1" />
        <meta-data android:name="shiroikuma.automation.min_format" android:value="1" />

        <service
            android:name=".MainService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
    </application>

</manifest>