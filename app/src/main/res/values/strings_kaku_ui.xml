    <!-- Capture -->
    <string name="kaku_cap_sec" translatable="false">Capture</string>
    <string name="kaku_cap_instant" translatable="false">Instant mode</string>
    <string name="kaku_cap_instant_desc" translatable="false">The capture box reads as soon as you let go of it after moving or resizing it, with its result in a small popup beside it.</string>
    <string name="kaku_cap_instant_size" translatable="false">Instant only for a box at most this narrow</string>
    <string name="kaku_cap_instant_any" translatable="false">Any size</string>
    <string name="kaku_cap_filter" translatable="false">Black-and-white filter (Tesseract)</string>
    <string name="kaku_cap_filter_desc" translatable="false">Tesseract reads a thresholded copy of the capture; long-press the box and drag to set the threshold. MangaOCR always reads the capture as it is.</string>
    <string name="kaku_cap_direction" translatable="false">Text direction (Tesseract)</string>
    <string name="kaku_cap_dir_auto" translatable="false">Automatic (from the box\'s shape)</string>
    <string name="kaku_cap_dir_h" translatable="false">Horizontal</string>
    <string name="kaku_cap_dir_v" translatable="false">Vertical</string>
    <string name="kaku_cap_direction_note" translatable="false">MangaOCR needs no direction: it reads either.</string>

    <!-- Camera -->
    <string name="kaku_cam_sec" translatable="false">Camera</string>
    <string name="kaku_cam_open" translatable="false">Open 白い熊 画 カメラ</string>
    <string name="kaku_cam_open_desc" translatable="false">OCR through the camera: the capture box over a full-screen camera picture. Freeze holds a frame still; tap to focus, pinch to zoom.</string>
    <string name="kaku_cam_icon" translatable="false">Launcher icon</string>
    <string name="kaku_cam_icon_desc" translatable="false">A second icon, 「白い熊 画 カメラ」, in the app drawer — one tap straight into the camera.</string>
    <string name="kaku_cam_live" translatable="false">Live mode</string>
    <string name="kaku_cam_live_desc" translatable="false">While the camera runs, the box re-reads the picture whenever it has settled, in the small popup beside the box. Also switchable in the camera view.</string>
    <string name="kaku_cam_settle" translatable="false">Still for, before reading</string>
    <string name="kaku_cam_routes" translatable="false">Also reachable: long-press the 白い熊 画 icon → 「カメラ」 (drag it to the home screen), the camera button on the start screen, the notification\'s Camera action, and the intent shiroikuma.kaku.action.CAMERA for 自由作業盤 / Tasker.</string>

    <!-- 保存復元 automation (sister-app contract v2) -->
    <string name="kaku_auto_switch" translatable="false">Automation export</string>
    <string name="kaku_auto_switch_desc" translatable="false">Let sister apps (白い熊 応用管理 · 白い熊 自由作業盤) run this export headlessly and back the data up. On by default.</string>
    <string name="kaku_auto_require_token" translatable="false">Use authorization token?</string>
    <string name="kaku_auto_require_token_desc" translatable="false">Off: any sister app may drive the automation. On: a caller must also present the token below. Either way the data door checks the caller’s package name and signature.</string>
    <string name="kaku_auto_token" translatable="false">Automation token</string>
    <string name="kaku_auto_token_desc" translatable="false">Tap to copy the full token · paste it into 自由作業盤「保存復元の設定」</string>
    <string name="kaku_auto_token_copied" translatable="false">Token copied to the clipboard.</string>
    <string name="kaku_auto_regenerate" translatable="false">Regenerate</string>
    <string name="kaku_auto_token_regen_title" translatable="false">Regenerate the token?</string>
    <string name="kaku_auto_token_regen_msg" translatable="false">The old token stops working at once. Every copy already pasted into 白い熊 自由作業盤 must be updated.</string>
    <string name="kaku_auto_token_regenerated" translatable="false">New token generated — update the pasted copies.</string>
